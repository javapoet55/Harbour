# Backend (Nexdo API) base URL, without a trailing slash. Server-side only.
BACKEND_URL=http://127.0.0.1:43217
# Must match one value of the backend's ADMIN_API_SECRETS (at least 32 characters).
ADMIN_API_SECRET=

# Optional: shows the "Go to Nexdo account login" link on the admin login page. Hidden when empty.
NEXDO_APP_URL=""