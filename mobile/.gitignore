# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Jest coverage output.
coverage/

# Python bytecode from scripts/diff.py
__pycache__/
*.pyc

# UI-parity captures of the Android app stay local; only the iPhone references are committed.
# (Captures tracked before pass 2 are left as they were.)
docs/reference/android/
docs/reference/diff/
