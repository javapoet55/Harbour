# Local demo uses SQLite. To share iOS/production users, set this to the Railway public Postgres URL.
# Never commit a production URL. Do not run db:seed or db:reset against Postgres.
HARBOR_DATABASE_URL="file:./dev.db"

# Sign session cookies. Rotate in production.
HARBOR_SESSION_SECRET="replace-with-a-long-random-string"
# Protect the server-to-server reminder ticker endpoint in production.
HARBOR_CRON_SECRET=""

# Seeded demo account
HARBOR_DEMO_EMAIL="alex@harbor.app"
HARBOR_DEMO_PASSWORD="harbor-demo"

# Optional providers. Empty values keep development mocks.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
SENDGRID_API_KEY=""
# Transactional email sender. EMAIL_FROM_* take precedence; SENDGRID_FROM_EMAIL / SENDGRID_FROM_NAME
# remain as fallbacks. Move the sender to a nexdoai.com address once SendGrid domain authentication is done.
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="Nexdo"
# Support address shown in the email footer; defaults to the sender address.
EMAIL_SUPPORT_ADDRESS=""
# Public HTTPS origin of this app, used for email images (public/email/). Defaults to the Railway production URL.
APP_URL=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="Harbour"
# Native Sign in with Apple. APPLE_PRIVATE_KEY is the .p8 contents; use \\n for newlines in hosted variables.
APPLE_CLIENT_ID="com.pinslots.nexdo"
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://127.0.0.1:43217/api/calendar/oauth/google/callback"
MICROSOFT_CALENDAR_CLIENT_ID=""
MICROSOFT_CALENDAR_CLIENT_SECRET=""
MICROSOFT_CALENDAR_REDIRECT_URI="http://127.0.0.1:43217/api/calendar/oauth/microsoft/callback"
# 32-byte key encoded as 64 hex characters. Required before storing production OAuth tokens.
HARBOR_CREDENTIAL_ENCRYPTION_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_APP_NAME="Harbor"

#sendgrid
SENDGRID_API_KEY=""

# Continuous Add by Voice; permanent credentials remain server-only.
# All conversational task workloads use gpt-realtime-2.1.
# Model selection is centralized in src/server/voice/configuration.ts.
# Legacy OPENAI_TASK_REALTIME_MODEL / OPENAI_REALTIME_MODEL overrides are ignored.

# Important Moments: separate, least-privilege Gmail send authorization.
# Register /api/moments/email/callback as the exact HTTPS redirect URI.
MOMENTS_GOOGLE_CLIENT_ID=
MOMENTS_GOOGLE_CLIENT_SECRET=
MOMENTS_GOOGLE_REDIRECT_URI=
# Enable only after a durable worker calls POST /api/moments/tick every minute
# with Authorization: Bearer <HARBOR_CRON_SECRET>.
MOMENTS_SCHEDULER_ENABLED=false

# Optional wish text model (independent of the general assistant)
MOMENTS_DRAFT_MODEL=gpt-4o-mini
# Separate persistent Moments worker only: HTTPS origin of the API service
MOMENTS_API_BASE_URL=

# Server-only Firebase/GA4 engagement reporting (never use NEXT_PUBLIC_).
# GA4 numeric property ID, NOT Firebase project number or measurement ID.
GA4_PROPERTY_ID=
# Entire JSON key of a dedicated service account with GA4 Viewer access.
GA4_SERVICE_ACCOUNT_JSON=
# Optional numeric app stream ID; defaults to iOS platform only if omitted.
GA4_STREAM_ID=

# Dedicated Hostinger sender for admin OTPs; no SendGrid fallback.
HOSTINGER_MAIL_API_KEY=""
NEXDO_ADMIN_FROM_EMAIL=""

# System Health: enable after deploying the 20260921000000_system_health migration.
NEXDO_HEALTH_ENABLED="false"
# Existing admin user IDs allowed to change health rules/incidents (admin OTP still required).
NEXDO_HEALTH_OPERATOR_IDS=""
# Optional operator-maintained USD per million input/output tokens, keyed by exact model ID.
# No default prices are assumed; missing prices display No telemetry.
NEXDO_AI_PRICES_JSON="{}"

# Phase 1 task research. Enable only after adding both provider keys.
NEXDO_AGENT_ENABLED="false"
GOOGLE_PLACES_API_KEY=""
YELP_API_KEY=""
