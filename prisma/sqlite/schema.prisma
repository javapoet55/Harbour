generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("HARBOR_DATABASE_URL")
}

model User {
  adminLoginTokens AdminLoginToken[]
  shoppingLists ShoppingList[]
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  photo        String?
  timeZone     String   @default("America/Los_Angeles")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  emailVerifiedAt DateTime?

  moments ImportantMoment[]
  momentEmailAccount MomentEmailAccount?
  preference         UserPreference?
  lists              TaskList[]
  projects           Project[]
  categories         Category[]
  tags               Tag[]
  tasks              Task[]
  events             CalendarEvent[]
  calendarConnections CalendarConnection[]
  reminders          Reminder[]
  voiceSessions      VoiceSession[]
  assistantActions   AssistantAction[]
  activityLogs       ActivityLog[]
  pushSubscriptions  PushSubscription[]
  memories           UserMemory[]
  workSessions       TaskWorkSession[]
  authIdentities     AuthIdentity[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  expiresAt DateTime
  usedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  refreshToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model UserPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingDays             String   @default("1,2,3,4,5")
  workStart               String   @default("09:00")
  workEnd                 String   @default("17:00")
  quietStart              String   @default("21:00")
  quietEnd                String   @default("07:00")
  defaultDurationMin      Int      @default(30)
  defaultReminderMinutes  Int      @default(30)
  confirmationLevel       String   @default("CHANGES_AND_DELETES")
  pushEnabled             Boolean  @default(true)
  emailEnabled            Boolean  @default(true)
  smsEnabled              Boolean  @default(false)
  morningSummary          Boolean  @default(true)
  eveningSummary          Boolean  @default(true)
  weeklySummary           Boolean  @default(true)
  escalateToEmailMinutes  Int      @default(15)
  escalateToSmsMinutes    Int      @default(45)
  voiceEnabled            Boolean  @default(true)
  transcriptRetentionDays Int      @default(30)
  audioRetentionHours     Int      @default(0)
  defaultCalendarId       String?
  phoneNumber             String?
  personalizationEnabled  Boolean  @default(false)
  personalizationConsentAt DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model TaskList {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      String    @default("CUSTOM")
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tasks     Task[]
}

model Project {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String    @default("#5b6abf")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tasks     Task[]
  @@index([userId, deletedAt, updatedAt])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      String   @default("personal")
  tasks     Task[]
}

model Tag {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  tasks  TaskTag[]
}

model Task {
  intentCategory String?
  intentScore Float?
  intentReason String?
  agentRun TaskAgentRun?
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listId               String?
  list                 TaskList? @relation(fields: [listId], references: [id])
  projectId            String?
  project              Project?  @relation(fields: [projectId], references: [id])
  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id])
  title                String
  notes                String    @default("")
  kind                 String    @default("TASK")
  status               String    @default("INBOX")
  priority             String    @default("NORMAL")
  startAt              DateTime?
  dueAt                DateTime?
  durationMin          Int       @default(30)
  splittable           Boolean   @default(false)
  minFocusMin          Int       @default(15)
  energyLevel          String    @default("MEDIUM")
  reminderAt           DateTime?
  lifeReminderType     String?
  lifeReminderConfidence Float?
  originalUserText     String?
  waitingOn            String?
  assignee             String?
  timeZone             String    @default("America/Los_Angeles")
  calendarEventId      String?
  externalEventId      String?
  idempotencyKey       String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedAt          DateTime?
  deletedAt            DateTime?
  notifyPush           Boolean   @default(true)
  notifyEmail          Boolean   @default(true)
  notifySms            Boolean   @default(false)
  critical             Boolean   @default(false)
  actualDurationMin    Int?
  startedAt            DateTime?
  postponeCount        Int       @default(0)
  lastRescheduledAt    DateTime?

  subtasks     Subtask[]
  reminders    Reminder[]
  recurrence   RecurrenceRule?
  dependencies TaskDependency[]  @relation("TaskDepends")
  dependents   TaskDependency[]  @relation("TaskBlocks")
  tags         TaskTag[]
  activities   ActivityLog[]
  workSessions TaskWorkSession[]
  @@index([userId, projectId, deletedAt, status])
}

model TaskWorkSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?
  createdAt   DateTime @default(now())

  @@index([userId, startedAt])
  @@index([taskId, startedAt])
}

model Subtask {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  completedAt DateTime?
  sortOrder   Int       @default(0)
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([taskId, tagId])
}

model TaskDependency {
  id           String @id @default(cuid())
  taskId       String
  dependsOnId  String
  task         Task   @relation("TaskDepends", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task   @relation("TaskBlocks", fields: [dependsOnId], references: [id], onDelete: Cascade)
}

model RecurrenceRule {
  id          String    @id @default(cuid())
  taskId      String    @unique
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  frequency   String
  interval    Int       @default(1)
  byWeekday   String?
  until       DateTime?
  count       Int?
}

model CalendarConnection {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  accountEmail  String
  calendarId    String
  calendarName  String
  visible       Boolean   @default(true)
  writeEnabled  Boolean   @default(false)
  syncToken     String?
  lastSyncedAt  DateTime?
  status        String    @default("connected")
  accessToken   String?
  refreshToken  String?
  tokenExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  events        CalendarEvent[] @relation("ImportedEvents")
  pushedEvents  CalendarEvent[] @relation("PushedEvents")

  @@unique([userId, provider, calendarId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserMemory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  value      String
  kind       String   @default("preference")
  confidence Float    @default(1)
  source     String   @default("assistant")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, key])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId  String?
  connection    CalendarConnection? @relation("ImportedEvents", fields: [connectionId], references: [id])
  title         String
  notes         String    @default("")
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean   @default(false)
  location      String    @default("")
  source        String    @default("harbor")
  externalId    String?
  syncKey       String?   @unique
  timeZone      String    @default("America/Los_Angeles")
  // A Nexdo-created event written back to a connected calendar (see pushEventToExternal).
  pushedConnectionId String?
  pushedConnection   CalendarConnection? @relation("PushedEvents", fields: [pushedConnectionId], references: [id], onDelete: SetNull)
  pushedExternalId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([pushedConnectionId, pushedExternalId])
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fireAt      DateTime
  offsetLabel String
  channelPlan String    @default("push,email")
  critical    Boolean   @default(false)
  status      String    @default("SCHEDULED")
  /// Bumped each time the reminder is moved to a new time; only attempts of the current generation count.
  generation  Int       @default(0)
  idempotencyKey String @unique
  acknowledgedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  attempts    NotificationAttempt[]
}

model NotificationAttempt {
  id           String    @id @default(cuid())
  reminderId   String
  reminder     Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  /// The reminder generation this attempt was made for; earlier ones are kept as history.
  generation   Int       @default(0)
  channel      String
  status       String
  failureReason String?
  retryCount   Int       @default(0)
  providerId   String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  createdAt    DateTime  @default(now())
}

model VoiceSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("idle")
  locale      String    @default("en-US")
  createdAt   DateTime  @default(now())
  transcripts VoiceTranscript[]
  actions     AssistantAction[]
}

model VoiceTranscript {
  id         String       @id @default(cuid())
  sessionId  String
  session    VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text       String
  corrected  String?
  confidence Float?
  createdAt  DateTime     @default(now())
}

model AssistantAction {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      VoiceSession? @relation(fields: [sessionId], references: [id])
  intent       String
  payloadJson  String
  confirmation String        @default("NONE")
  executed     Boolean       @default(false)
  resultJson   String        @default("{}")
  createdAt    DateTime      @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  kind      String
  summary   String
  createdAt DateTime @default(now())
}

model ImportantMoment {
  festivalSettings String @default("{}")
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  title String
  firstName String @default("")
  phone String @default("")
  email String @default("")
  occurrenceDate String
  timeZoneID String
  yearly Boolean @default(false)
  source String @default("manual")
  sourceKey String
  enabled Boolean @default(true)
  snoozedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  drafts WishDraft[]
  cardImages GreetingCardImage[]
  @@unique([userId, sourceKey])
}
model WishDraft {
  id String @id @default(cuid())
  momentID String
  moment ImportantMoment @relation(fields: [momentID], references: [id], onDelete: Cascade)
  tone String @default("Warm")
  body String
  personalContext String @default("")
  generationVersion Int @default(1)
  status String @default("NEEDS_REVIEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plans DeliveryPlan[]
}
model DeliveryPlan {
  id String @id @default(cuid())
  draftID String
  draft WishDraft @relation(fields: [draftID], references: [id], onDelete: Cascade)
  channel String
  recipient String
  subject String
  body String
  scheduledAtUTC DateTime
  timeZoneID String
  automaticDelivery Boolean @default(false)
  reminderOffset Int @default(0)
  annualMonthDay String @default("")
  repeatYearly Boolean @default(false)
  status String @default("SCHEDULED")
  idempotencyKey String @unique
  providerMessageID String?
  lastError String?
  attempts Int @default(0)
  nextAttemptAt DateTime
  claimedAt DateTime?
  sentAt DateTime?
  approvedAt DateTime
  // The greeting card an automatic email includes; repointed when the card is saved again before sending.
  cardId String?
  card GreetingCardImage? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
}
// The finished greeting card (artwork, greeting and signature) as the user saved it. Rows are immutable:
// saving again adds a row, so a send in progress keeps the image it started with. The moment's card is
// its one row with no retiredAt; retired rows stay only while a sent or in-flight delivery refers to them.
model GreetingCardImage {
  id String @id @default(cuid())
  momentId String
  moment ImportantMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId String
  mime String
  bytes Bytes
  size Int
  sha256 String
  createdAt DateTime @default(now())
  retiredAt DateTime?
  plans DeliveryPlan[]
  @@index([momentId, createdAt])
}
model MomentEmailAccount {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String
  refreshToken String
  status String @default("connected")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShoppingList {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  date String
  timeZone String
  weekly Boolean @default(false)
  completedAt DateTime?
  revision Int @default(0)
  generatedFrom String? @unique
  shareToken String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items ShoppingItem[]
  @@index([userId, date])
}
model ShoppingItem {
  id String @id
  listId String
  list ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  imageData String?
  name String
  category String
  quantity String @default("1")
  size String @default("")
  notes String @default("")
  checked Boolean @default(false)
  barcode String?
  brand String?
  favorite Boolean?
  favoriteAlternatives Json?
  sortOrder Int @default(0)
  @@index([listId, sortOrder])
}

model AdminLoginToken {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  expiresAt DateTime
  usedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  sessionHash String? @unique
  sessionExpiresAt DateTime?
  @@index([userId, createdAt])
}

model HealthEvent {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  kind String
  service String
  operation String
  feature String
  model String?
  traceId String
  status Int
  durationMs Float
  errorCode String?
  inputTokens Int?
  outputTokens Int?
  costUsd Float?
  @@index([createdAt])
  @@index([kind, service, createdAt])
  @@index([traceId])
}

model HealthIncident {
  id String @id @default(cuid())
  activeKey String? @unique
  service String
  severity String
  trigger String
  status String @default("OPEN")
  ownerId String?
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  @@index([startedAt])
}

model HealthRule {
  id String @id
  threshold Float
  minimumSamples Int @default(20)
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model HealthAudit {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  actorId String
  action String
  targetId String
  detail String
  @@index([targetId, createdAt])
}

model TaskAgentRun {
  id String @id @default(cuid())
  taskId String @unique
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status String @default("NEEDS_INPUT")
  service String
  urgency String
  slotsJson String
  stepsJson String
  resultsJson String @default("[]")
  warningsJson String @default("[]")
  error String?
  version Int @default(0)
  attempts Int @default(0)
  leaseUntil DateTime?
  targetAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, leaseUntil])
}

// Shared, versioned factual food-data and explanation cache. No user identifiers.
model FoodDataCache {
  key String @id
  schemaVersion Int @default(1)
  payload String?
  expiresAt DateTime
  staleUntil DateTime
  leaseUntil DateTime
  @@index([staleUntil])
}

model FoodProviderBudget {
  key String @id
  count Int @default(0)
  resetAt DateTime
}
